# Files that belong to this machine, not to the repository.
.DS_Store
*.swp

# Runtime noise
/error_log
/php_errors.log

# The file manager's working folder: uploaded files belong to the server,
# not to the repository. The folder itself is kept so a fresh checkout works.
/sifm/home/*
!/sifm/home/.gitkeep

# The SiFM demo wrapper: it belongs to this server, not to the repository.
# sifm/README.md has the ten lines it takes to recreate it.
/sifm/demo/

# Local/site-specific (not for GitHub)
ads.txt

# Composer packages (installed locally; not committed)
vendor/bacon/
vendor/dasprid/
vendor/endroid/

