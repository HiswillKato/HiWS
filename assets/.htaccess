# Belt and braces for the one folder the browser downloads from. It only ever
# holds CSS, JavaScript, fonts and images, so nothing inside it should be able
# to run as a script even if a file with a dangerous name lands here.

Options -Indexes

<FilesMatch "\.(?i:ph(?:p[0-9]?|tml|ar|ps[0-9]?|inc))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    SetHandler None
    RemoveHandler .php .phtml .phar
    RemoveType .php .phtml .phar
</FilesMatch>

<FilesMatch "^\.ht">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
